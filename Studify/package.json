{
  "name": "studify",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start --localhost",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "react-native-gesture-handler/jestSetup"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/test/jest.setup.js"
    ],
    "moduleNameMapper": {
      "^.+\\.(png|jpg|jpeg|gif|webp|ttf|woff|woff2)$": "<rootDir>/test/assetStub.js"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|expo-constants|expo-crypto|expo-sqlite|expo-linear-gradient|expo-image-picker|expo-blur|expo-status-bar|@react-native-async-storage/async-storage)"
    ]
  },
  "dependencies": {
    "@expo/metro-runtime": "~5.0.4",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-navigation/native": "^7.1.33",
    "@react-navigation/native-stack": "^7.14.5",
    "@react-navigation/stack": "^7.4.8",
    "expo": "~53.0.22",
    "expo-blur": "~14.1.5",
    "expo-crypto": "~14.1.5",
    "expo-image-picker": "~16.1.4",
    "expo-linear-gradient": "~14.1.5",
    "expo-notifications": "~0.31.5",
    "expo-splash-screen": "~0.30.10",
    "expo-sqlite": "~15.2.14",
    "expo-status-bar": "~2.2.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-web": "^0.20.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@testing-library/react-native": "^13.3.0",
    "dotenv": "^17.4.2",
    "jest": "~29.7.0",
    "jest-expo": "~53.0.0",
    "react-test-renderer": "19.0.0",
    "sql.js": "^1.14.1"
  },
  "private": true,
  "description": "",
  "directories": {
    "test": "test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs"
}
